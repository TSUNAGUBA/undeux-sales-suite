# docker compose 用の環境変数。実値を設定したファイルを .env としてコピーする。
# .env は Git 管理対象外（.gitignore 済み）。

# --- PostgreSQL ---
POSTGRES_PASSWORD=undeux

# --- フロントエンドのオリジン（API の CORS 許可に使用） ---
FRONTEND_ORIGIN=http://localhost:3000

# --- ブラウザから見た API のベースURL（フロントエンドのビルドに埋め込まれる） ---
API_BASE_URL=http://localhost:8080

# --- Firebase（Firebase コンソール > プロジェクト設定 から取得） ---
# 未設定でもアプリは起動するが、ログイン（認証）は利用できない。
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# --- Google Vertex AI（Gemini。AI機能に使用） ---
# 未設定でもアプリは起動するが、業務チャット・商談チャット・副資材チェックは「AI未設定」となる。
# ナレッジ登録・検索（RAG設定）は未設定でも利用できる（画像の自動説明のみ不可）。
# VERTEX_PROJECT_ID を設定すると AI 有効。SA 鍵(base64) が空なら ADC を使う。
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_SA_JSON_BASE64=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
