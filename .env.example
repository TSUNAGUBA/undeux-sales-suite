# docker compose 用の環境変数。実値を設定したファイルを .env としてコピーする。
# .env は Git 管理対象外（.gitignore 済み）。

# --- PostgreSQL ---
POSTGRES_PASSWORD=undeux

# --- フロントエンドのオリジン（API の CORS 許可に使用） ---
FRONTEND_ORIGIN=http://localhost:3000

# --- ブラウザから見た API のベースURL（フロントエンドのビルドに埋め込まれる） ---
API_BASE_URL=http://localhost:8080

# --- Firebase（Firebase コンソール > プロジェクト設定 から取得） ---
# 未設定でもアプリは起動するが、ログイン（認証）は利用できない。
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
