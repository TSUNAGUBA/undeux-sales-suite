# フロントエンドのビルド時環境変数（ssr:false のため値はビルド時に埋め込まれる）
# 実値を設定したファイルは .env としてコピーする（.env は Git 管理対象外）。

# バックエンドAPIのベースURL
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Firebase Web アプリ設定（Firebase コンソール > プロジェクト設定 > マイアプリ）
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
